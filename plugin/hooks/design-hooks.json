{
  "description": "design 插件：使用方项目（HeroUI，或还没换的 @su 旧项目）开会话时提醒改界面先走 design 技能；写界面文件前确认读全了设计总纲、规则与流程、用 Mobbin 看过先例，新页面还要读过布局手册、做过方案图；改完界面文件查文案、配色、间距、原生日期框（旧项目再查圆角）。",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/session-context.mjs\"", "timeout": 5 }]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|apply_patch|ApplyPatch|Bash",
        "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/precedent-gate.mjs\"", "timeout": 15 }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|apply_patch|ApplyPatch",
        "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/static-gate.mjs\"", "timeout": 15 }]
      }
    ]
  }
}
